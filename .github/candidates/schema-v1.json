{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compas.dev/schemas/candidate-artifacts-v1.json",
  "title": "COMPAS coordinated candidate artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "os", "architecture", "python"],
      "properties": {
        "runner": {"const": "ubuntu-24.04"},
        "os": {"const": "linux"},
        "architecture": {"const": "x86_64"},
        "python": {"const": "3.12"}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "repository",
        "commit",
        "workflow",
        "artifact",
        "wheel",
        "depends_on"
      ],
      "properties": {
        "distribution": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow": {"$ref": "#/$defs/workflow"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "wheel": {"$ref": "#/$defs/wheel"},
        "depends_on": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_attempt", "path", "event", "pull_request", "base_ref"],
      "properties": {
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "path": {
          "type": "string",
          "pattern": "^\\.github/workflows/.+\\.ya?ml$"
        },
        "event": {"enum": ["pull_request", "push", "workflow_dispatch"]},
        "pull_request": {"type": ["integer", "null"], "minimum": 1},
        "base_ref": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"event": {"const": "pull_request"}}},
          "then": {
            "properties": {
              "pull_request": {"type": "integer", "minimum": 1},
              "base_ref": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "pull_request": {"type": "null"},
              "base_ref": {"type": "null"}
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "archive_sha256"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "archive_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/]+\\.whl$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
